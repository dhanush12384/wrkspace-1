




generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String    @default("admin123")
  organizationName String?   @default("My Organization")
  allowedPages     String?   @default("overview,employees,leaves,attendance,clients,system_status,messages,task_allocation,events,work_submissions,leads")
  inviteToken      String?   @unique
  activeOtp        String?
  otpExpiresAt     DateTime?
  createdAt        DateTime  @default(now())
  isTeamLead       Boolean   @default(false)
  employeeId       String?   @unique
}

model Employee {
  id           String   @id 
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  phone        String
  wingName     String
  wingLeadName String
  role         String   @default("Employee")
  createdAt    DateTime @default(now())
  password     String?
  activeOtp    String?
  otpExpiresAt DateTime?
  
  peerViewOtp           String?
  peerViewOtpExpiresAt  DateTime?
  
  gender       String   @default("UNSPECIFIED")
  fcmToken     String?
  homeLat      Float?
  homeLng      Float?
  homePlusCode String?
  homeAddress  String?
  homeRadiusM  Int      @default(100)
  
  homeEditAllowed Boolean @default(true)
  
  photoUrl     String?
  
  idCardUrl    String?
  
  employmentStatus String @default("Active")
  
  about        String?  @db.Text
  
  remarks      String?  @db.Text
  monthWorked  String?  @db.Text
  companyWorkedFor String?  @db.Text
  overallScore String?
  conduct      String?  @db.Text
  
  qualifications String? @db.Text
  
  certifications String? @db.Text
  
  experience   String?  @db.Text
  
  projects     String?  @db.Text
  
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  
  professionalTitle String?
  city         String?
  state        String?
  country      String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  leetcodeUrl  String?
  codeforcesUrl String?
  codechefUrl  String?
  hackerrankUrl String?

  
  careerObjective   String? @db.Text
  yearsOfExperience String?
  industry          String?

  
  
  education      String? @db.Text
  
  skills         String? @db.Text
  
  achievements   String? @db.Text
  
  internships    String? @db.Text
  
  publications   String? @db.Text
  
  customSections String? @db.Text
  
  personalFileUrl String? @db.Text
  summaryFileUrl  String? @db.Text
  skillsFileUrl   String? @db.Text
  
  lastLat      Float?
  lastLng      Float?
  lastLocationAt DateTime?
  
  liveTrackActive Boolean @default(false)
  sosIncidents SosIncident[]
  safetyTrips  SafetyTrip[]
}


model LiveTrackConfig {
  id        String    @id @default("global")
  active    Boolean   @default(false)
  startedAt DateTime?
  startedBy String?
  updatedAt DateTime  @updatedAt
}

model SosIncident {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  status      String    @default("OPEN") 
  lat         Float
  lng         Float
  note        String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([employeeId])
}

model SafetyTrip {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  status      String    @default("IN_TRANSIT") 
  
  dateKey     String?
  lat         Float?
  lng         Float?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  updatedAt   DateTime  @updatedAt
  points      SafetyTripPoint[]

  @@index([status])
  @@index([employeeId])
  @@index([dateKey])
  @@index([employeeId, dateKey])
}


model SafetyTripPoint {
  id         String     @id @default(uuid())
  tripId     String
  trip       SafetyTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime   @default(now())

  @@index([tripId])
  @@index([recordedAt])
  @@index([tripId, recordedAt])
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String
  reportTo     String
  assigneeId   String   
  assigneeName String   
  deadline     DateTime
  status       String   @default("Pending") 
  mode         String   @default("Onsite")  
  allocatorName String?
  allocatorRole String?
  createdAt    DateTime @default(now())
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employeeName String
  startDate    DateTime
  endDate      DateTime
  type         String
  reason       String
  status       String   @default("Pending") 
  createdAt    DateTime @default(now())
}

model Attendance {
  id           String   @id @default(uuid())
  employeeId   String
  employeeName String
  date         String   
  checkIn      String   
  checkOut     String?  
  status       String   
  
  checkoutReminderSent Boolean @default(false)
  createdAt    DateTime @default(now())
}

model Message {
  id             String            @id @default(uuid())
  channel        String            
  senderId       String
  senderName     String
  content        String            @default("")
  
  attachmentType String?
  attachmentName String?
  
  attachmentUrl  String?           @db.Text
  replyToId      String?
  replyPreview   String?
  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  reactions      MessageReaction[]
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  userName  String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model ChannelAccessRequest {
  id           String   @id @default(uuid())
  employeeId   String
  employeeName String
  channel      String   
  status       String   @default("Pending") 
  createdAt    DateTime @default(now())
  @@unique([employeeId, channel])
}

model Event {
  id                  String   @id @default(uuid())
  title               String
  description         String
  organisingCollege   String
  representatives     String   
  startDate           DateTime
  endDate             DateTime
  startTime           String   
  endTime             String   
  venueAddress        String
  allowed             Boolean  @default(true)
  source              String   @default("Manual") 
  sourceUrl           String?
  imageUrl            String?
  createdAt           DateTime @default(now())
}

model WorkSubmission {
  id           String   @id @default(uuid())
  employeeId   String
  employeeName String
  title        String
  description  String
  taskId       String?  
  taskTitle    String?  
  hoursSpent   Float
  status       String   @default("Submitted") 
  adminNote    String?
  submittedAt  DateTime @default(now())
}

model Lead {
  id           String   @id @default(uuid())
  businessName String
  contactName  String?
  email        String?
  phone        String?
  website      String?
  location     String?
  category     String?
  source       String   
  sourceUrl    String?
  description  String?
  rating       String?
  reviewCount  String?
  status       String   @default("New")   
  priority     String   @default("Medium") 
  notes        String?
  assignedTo   String?  
  allowed      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HrCompany {
  id                  String   @id @default(uuid())
  companyName         String
  website             String?
  industry            String?
  location            String?
  hrName              String
  hrEmail             String?
  hrPhone             String?
  source              String   @default("Manual") 
  sourceUrl           String?
  notes               String?
  status              String   @default("New")    
  allowed             Boolean  @default(true)     
  assignedEmployeeId  String?  
  createdAt           DateTime @default(now())
}


model Office {
  id           String     @id @default(uuid())
  name         String
  address      String?
  lat          Float
  lng          Float
  plusCode     String?
  radiusMeters Int        @default(75)
  geofenceM    Int        @default(300)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  qrs          OfficeQr[]
}

model OfficeQr {
  id        String   @id @default(uuid())
  officeId  String
  label     String
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId])
}


model VerificationCompany {
  id           String                   @id @default(uuid())
  name         String
  contactEmail String?
  contactPhone String?
  notes        String?
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  createdBy    String?
  users        VerificationPortalUser[]
}


model VerificationPortalUser {
  id          String               @id @default(uuid())
  email       String               @unique
  password    String
  displayName String?
  
  role        String               @default("COMPANY")
  companyId   String?
  company     VerificationCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  lastLoginAt DateTime?

  @@index([companyId])
  @@index([role])
}
